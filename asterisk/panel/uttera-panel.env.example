# Uttera call panel — copy to /etc/uttera/panel.env and edit, then
#   chmod 600 /etc/uttera/panel.env   (it holds your API key)
#
# The panel is READ-ONLY over your PBX and binds to localhost by default; put it
# behind your own HTTPS reverse proxy. It exposes call recordings and
# transcripts (personal data), so set a password.

PANEL_CDR=/var/log/asterisk/cdr-csv/Master.csv
PANEL_MONITOR=/var/spool/asterisk/monitor
PANEL_BIND=127.0.0.1
PANEL_PORT=8973

# HTTP Basic auth. PANEL_PASS is REQUIRED in production: an empty password
# leaves the panel open, and it serves recordings.
PANEL_USER=admin
PANEL_PASS=

# On-demand "summary" and "signed PDF" call api.uttera.ai. The key goes here,
# never in the dialplan. The signed PDF report (report=pdf) needs a Developer
# plan or above; the transcript/intelligence you already have from the
# recordings connector need no key.
UTTERA_API=https://api.uttera.ai
UTTERA_API_KEY=
UTTERA_LANG=es
UTTERA_MODEL=whisper-1

# How many bytes of the (append-only) CDR tail to read for the recent view.
PANEL_TAIL_BYTES=2097152

# Call direction (in/out). cdr-csv does not record it, so the panel infers it
# from the channel technology first: a call whose source channel is a trunk is
# inbound; an internal channel dialling a trunk is outbound. It falls back to
# extension length when the channels are ambiguous. Adjust all three to your
# dial plan (comma-separated prefixes; leave a value empty to disable that rule).
PANEL_TRUNK_TECH=DAHDI
PANEL_INTERNAL_TECH=SIP/,PJSIP/,Local/
# Digits at or below this length are treated as internal extensions (fallback).
PANEL_EXT_MAXLEN=4

# The Settings page (/settings) persists panel/report headers, the logo and the
# recording-pipeline options (auto-summary, min chars, custom vocabulary) here.
# PANEL_CACHE is where the panel writes the summaries and signed PDFs it makes on
# demand (<uid>-summary.json, <uid>-report.pdf), so each is billed only once;
# reads also look in PANEL_MONITOR, where the recordings wrapper drops summaries.
# The shipped systemd unit runs read-only over the filesystem (ProtectSystem=
# strict) with one writable StateDirectory, /var/lib/uttera-panel — so both of
# these point there. If you run the panel unhardened, the monitor dir is fine too.
PANEL_SETTINGS=/var/lib/uttera-panel/panel-settings.json
PANEL_CACHE=/var/lib/uttera-panel

# Extra read-only users besides the admin above. They can view calls, play
# recordings, and generate/email reports, but CANNOT open /settings. Format:
#   user1:pass1,user2:pass2
PANEL_USERS=

# Emailing the signed PDF. With PANEL_SMTP_USER empty the message is handed to
# the local MTA (127.0.0.1:25). With a user+pass the panel authenticates over
# STARTTLS to your submission host, so your relay accepts it as an authenticated
# sender (passes DMARC) instead of trusting the source IP. Recipients, sender and
# the subject/body templates are set in /settings, not here.
PANEL_SMTP_HOST=127.0.0.1
PANEL_SMTP_PORT=25
PANEL_SMTP_USER=
PANEL_SMTP_PASS=

# Audit log: who accessed/played/emailed which recording, and when. The shipped
# systemd unit's LogsDirectory makes /var/log/uttera-panel writable under
# ProtectSystem=strict.
PANEL_AUDIT_LOG=/var/log/uttera-panel/audit.log
