{
  "name": "n8n-nodes-uttera",
  "version": "0.2.0",
  "description": "n8n node for Uttera: transcribe, summarise and translate audio, text to speech, sound effects and music",
  "license": "Apache-2.0",
  "homepage": "https://uttera.ai",
  "keywords": [
    "n8n-community-node-package",
    "uttera",
    "speech-to-text",
    "text-to-speech",
    "sound-effects",
    "music",
    "transcription",
    "whisper"
  ],
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/Uttera/*.png dist/nodes/Uttera/",
    "check": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/UtteraApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Uttera/Uttera.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}