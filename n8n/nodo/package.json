{
  "name": "n8n-nodes-uttera",
  "version": "0.2.4",
  "description": "n8n node for Uttera: transcribe, summarise and translate audio, text to speech, sound effects and music",
  "license": "MIT",
  "homepage": "https://uttera.ai",
  "keywords": [
    "n8n-community-node-package",
    "uttera",
    "speech-to-text",
    "text-to-speech",
    "sound-effects",
    "music",
    "transcription",
    "whisper"
  ],
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/Uttera/*.png nodes/Uttera/*.svg dist/nodes/Uttera/ && cp credentials/*.svg dist/credentials/",
    "check": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/UtteraApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Uttera/Uttera.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uttera/uttera-examples.git",
    "directory": "n8n/nodo"
  },
  "bugs": {
    "url": "https://github.com/uttera/uttera-examples/issues"
  },
  "author": {
    "name": "Uttera",
    "email": "fakehec@espuny.net"
  },
  "engines": {
    "node": ">=20.15"
  }
}