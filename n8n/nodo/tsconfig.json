{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2019",
    "lib": ["es2019", "es2020.promise"],
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "dist",
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "include": ["credentials/**/*", "nodes/**/*"]
}
